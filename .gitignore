# Dependencies
node_modules/

# Build output. NOT a bare `lib/`: the frontend keeps its application code in
# `packages/frontend/lib`, and ignoring that pattern globally silently drops
# every module behind the `@/lib/*` alias — a commit that looks complete and a
# build that cannot resolve its own imports. `shared-types` builds to `dist/`.
dist/
web-build/

# Expo
.expo/
.expo-shared/
*.orig.*
expo-env.d.ts.bak

# Native
/ios/
/android/

# Env
.env
.env.local
.env*.local

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Misc
.DS_Store
*.tsbuildinfo
.turbo/
