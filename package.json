{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/shared-types",
    "packages/frontend"
  ],
  "scripts": {
    "dev:frontend": "bun run --cwd packages/frontend start",
    "build:shared-types": "bun run --cwd packages/shared-types build",
    "build:frontend": "bun run --cwd packages/frontend export:web",
    "lint": "biome check . && bun run --cwd packages/frontend lint",
    "postinstall": "bun run build:shared-types",
    "test:worker": "bun test scripts/worker.test.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:store": "bun test scripts/store-session.test.tsx && bun test scripts/write-review.test.tsx && bun test scripts/review-account-ownership.test.ts && bun test scripts/review-sdk-subject.test.ts && bun test scripts/store-compiler.test.tsx && bun test scripts/install-action.test.tsx"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@babel/plugin-transform-typescript": "7.29.7",
    "@biomejs/biome": "2.5.15",
    "@types/react-test-renderer": "19.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "react-test-renderer": "19.3.0"
  },
  "overrides": {
    "@oxy.so/core": "7.9.1",
    "@oxy.so/bloom": "15.66.0",
    "@oxy.so/contracts": "6.1.0",
    "@oxy.so/protocol": "1.5.1",
    "@oxy.so/services": "13.14.1",
    "react-native-css": "3.1.0-rc.0",
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "@oxy.so/core": "7.9.1",
    "@oxy.so/bloom": "15.66.0",
    "@oxy.so/contracts": "6.1.0",
    "@oxy.so/protocol": "1.5.1",
    "@oxy.so/services": "13.14.1",
    "react-native-css": "3.1.0-rc.0",
    "lightningcss": "1.30.1"
  }
}
