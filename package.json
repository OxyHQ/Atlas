{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/shared-types",
    "packages/frontend"
  ],
  "scripts": {
    "dev:frontend": "bun run --cwd packages/frontend start",
    "build:shared-types": "bun run --cwd packages/shared-types build",
    "build:frontend": "bun run --cwd packages/frontend export:web",
    "lint": "biome check . && bun run --cwd packages/frontend lint",
    "postinstall": "bun run build:shared-types",
    "test:worker": "bun test scripts/worker.test.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  },
  "overrides": {
    "@oxy.so/core": "6.0.0",
    "@oxy.so/bloom": "14.0.0",
    "@oxy.so/contracts": "5.0.0",
    "@oxy.so/protocol": "1.4.1",
    "@oxy.so/services": "11.17.0",
    "react-native-css": "3.1.0-rc.0"
  },
  "resolutions": {
    "@oxy.so/core": "6.0.0",
    "@oxy.so/bloom": "14.0.0",
    "@oxy.so/contracts": "5.0.0",
    "@oxy.so/protocol": "1.4.1",
    "@oxy.so/services": "11.17.0",
    "react-native-css": "3.1.0-rc.0"
  }
}
